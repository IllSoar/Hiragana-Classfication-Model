    "# Model Compile、Model Save の実装\n",
    "### ※エポックごとにモデルを永続化した後、\n",
    "### 　生成されたすべてのモデルを比べ、モデルを選ぶことにしました。"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 8,
   "id": "0e872a22-2713-4745-9d18-04e9c5e5a1dd",
   "metadata": {},
   "outputs": [],
   "source": [
    "if not os.path.exists('model'):\n",
    "    os.mkdir('model')\n",
    "elif os.path.exists('model'):\n",
    "    for file in os.listdir('model'):\n",
    "        os.remove(f'model/{file}')\n",
    "    os.rmdir('model')\n",
    "    os.mkdir('model')\n",
    "checkpoint = tf.keras.callbacks.ModelCheckpoint(\n",
    "    filepath='model/{epoch:03d}epoch_v_loss{val_loss:.2f}_v_acc{val_accuracy:.2f}_model.h5', monitor='val_accuracy', save_best_only=False, mode='max')\n",
    "\n",
    "model.compile(optimizer=tf.keras.optimizers.Adam(learning_rate=0.0005),loss='sparse_categorical_crossentropy', metrics=['accuracy'])"
   ]
  },
